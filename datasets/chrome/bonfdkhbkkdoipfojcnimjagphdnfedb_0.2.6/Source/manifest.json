{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "DataHive",
  "description": "DePIN for data collection",
  "version": "0.2.6",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "32": "icon-32-production.png"
    }
  },
  "icons": {
    "128": "icon-128-production.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "declarativeNetRequest",
    "system.cpu",
    "system.memory",
    "webRequest",
    "tabs",
    "scripting"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/frame.ts-loader-Dhm2S3m-.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "js": [
        "assets/disable_autoplay.ts-loader-FW6gLVUa.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [],
      "resources": [
        "icon-128-production.png",
        "icon-32-production.png"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "<all_urls>",
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/network-idle-monitor-Bj9nPbL_.js",
        "assets/messenger-Bhk1-rYU.js",
        "assets/init-Cpj_yYth.js",
        "assets/_sentry-release-injection-file-uLtnKHl9.js",
        "assets/index-BSbhqchi.js",
        "assets/types-hMwHdYwy.js",
        "assets/_commonjsHelpers-CehW6b88.js",
        "assets/frame.ts-Ds2hdpQz.js",
        "assets/disable_autoplay.ts-DeMgHnnU.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/messenger-Bhk1-rYU.js",
        "assets/network-idle-monitor-Bj9nPbL_.js",
        "assets/_sentry-release-injection-file-uLtnKHl9.js",
        "assets/index-BSbhqchi.js",
        "assets/types-hMwHdYwy.js",
        "assets/_commonjsHelpers-CehW6b88.js",
        "assets/tab-script.ts-Csnfu7UR.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "iframe_ruleset",
        "enabled": true,
        "path": "src/rules.json"
      }
    ]
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://datahive-dashboard-development.web.app/*",
      "https://datahive-dashboard-staging.web.app/*",
      "https://datahive-dashboard-production-non-store.web.app/*",
      "https://dashboard.datahive.xyz/*",
      "https://dashboard.datahive.ai/*"
    ]
  },
  "version_name": "0.2.6"
}
