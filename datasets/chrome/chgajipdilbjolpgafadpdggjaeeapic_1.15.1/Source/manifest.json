{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "CertiPlugin Chrome",
  "version": "1.15.1",
  "description": "Extensão utilizada para manipular certificados digitais. Esta extensão é utilizada somente nas aplicações da Certisign.",
  "icons":{
    "16":"16x16.png",
    "48":"48x48.png",
    "128":"128x128.png"
  },
  "key": "",
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts":[
    {
      "matches":[
        "https://*.certisign.com.br/*",
        "https://*.certintra.com.br/*",
        "http://*.certisign.com.br/*",
        "http://*.certintra.com.br/*",
        "https://*.sydle.one/*"
      ],
      "js":[
        "certisignerconf.js",
        "common.js",
        "basic.js",
        "extended.js"
      ]
    }
  ],
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://*.certisign.com.br/*",
    "https://*.certintra.com.br/*",
    "http://*.certisign.com.br/*",
    "http://*.certintra.com.br/*"
  ],
  "short_name": "CertiPlugin"
}