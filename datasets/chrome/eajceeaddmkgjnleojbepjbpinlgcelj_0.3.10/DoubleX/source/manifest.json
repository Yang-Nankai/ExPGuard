{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "Chakra Scout",
  "version": "0.3.10",
  "description": "Contribute to the open database of the internet.",
  "key": "",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "world": "MAIN",
      "matches": [
        "https://*.chakra.dev/*",
        "https://x.com/*",
        "https://pro.x.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://stackoverflow.com/*",
        "https://*.stackexchange.com/*",
        "https://www.quora.com/*",
        "https://www.youtube.com/*",
        "https://*.googlevideo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.chakra.dev/*",
        "https://x.com/*",
        "https://pro.x.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*",
        "https://stackoverflow.com/*",
        "https://*.stackexchange.com/*",
        "https://www.quora.com/*",
        "https://www.youtube.com/*",
        "https://*.googlevideo.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "*://*.chakra.dev/*",
    "https://x.com/*",
    "https://pro.x.com/*",
    "https://www.linkedin.com/*",
    "https://www.reddit.com/*",
    "https://stackoverflow.com/*",
    "https://*.stackexchange.com/*",
    "https://www.quora.com/*",
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://*.chakra.dev/*"
    ]
  }
}