{
"update_url": "https://clients2.google.com/service/update2/crx",

  "background": {
    "service_worker": "background.js"
  },
  "description": "Displays an icon if there is a X website tag on a given page",
  "icons": {
    "128": "icon.png"
  },
  "manifest_version": 3,
  "name": "X Pixel Helper",
  "action": {
    "default_icon": {
      "128": "icon.png"
    },
    "default_popup": "popup.html",
    "default_title": "There is a X website tag on this page"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "version": "3.0.4",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}