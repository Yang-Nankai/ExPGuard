{
"update_url": "https://clients2.google.com/service/update2/crx",

  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/logo_128.png"
    }
  },
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "icons": {
    "128": "icons/logo_128.png"
  },
  "options_page": "./options.html",
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "key": "",
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.linkedradar.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kodepay.io/*"
      ],
      "js": [
        "js/kodepay-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "js/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo_128.png",
        "options.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "identity"
  ],
  "version": "1.9.0"
}