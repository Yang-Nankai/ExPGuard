{
"update_url": "https://clients2.google.com/service/update2/crx",

  "name": "Kaisar ZeroNode",
  "description": "Kaisar ZeroNode",
  "version": "1.0.13",
  "manifest_version": 3,
  "icons": {
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "action": {
    "default_title": "Kaisar ZeroNode",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.kaisar.io/*"
  ]
}