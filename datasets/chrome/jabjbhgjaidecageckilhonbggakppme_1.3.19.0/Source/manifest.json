{
  "manifest_version": 3,
  "name": "Госплагин",
  "description": "Расширение для браузера «Госплагин»",
  "version": "1.3.19.0",
   "key": "", 
   "update_url":"https://clients2.google.com/service/update2/crx", 

  "background": {
     "service_worker": "background.js",
     "type": "module"
  },
  
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "includes/jquery.js", "includes/formats.js", "includes/base64.js", "content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],  
  
  "action": {
    "default_title": "Госплагин",
    "default_popup": "popup/popup.htm",
    "default_icon": {
		"16": "img/logo/logo_16x16.png",
		"32": "img/logo/logo_32x32.png",
		"48": "img/logo/logo_48x48.png",
		"64": "img/logo/logo_64x64.png",
		"128": "img/logo/logo_128x128.png"		
    }
  },
  

  "icons": {
    "16": "img/logo/logo_16x16.png",
    "32": "img/logo/logo_32x32.png",
    "48": "img/logo/logo_48x48.png",
    "64": "img/logo/logo_64x64.png",
    "128": "img/logo/logo_128x128.png"
  },

  "permissions": [  "alarms", "storage", "nativeMessaging", "notifications" ],
  "host_permissions": [ "\u003Call_urls>" ]
  
}