  "manifest_version": 3,
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "options_page": "src/scripts/options/index.html",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "minimum_chrome_version": "119",
