      "http://localhost/*",
      "http://localhost:3000/",
      "https://*.cursive.io/*",
      "https://*.scribehow.com/*",
      "https://*.scribe.com/*",
      "https://*.scribehow-dev.com/*",
      "https://*.scribe-dev.com/*",
      "https://*.scribehow-stage.com/*"
