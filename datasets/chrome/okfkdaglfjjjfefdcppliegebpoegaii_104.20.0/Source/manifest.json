{
"update_url": "https://clients2.google.com/service/update2/crx",

  "name": "Scribe: AI Documentation, SOPs & Process Intelligence",
  "version": "104.20.0",
  "description": "Turn any workflow into documentation your teams and AI agents can follow. Save each team member 35 hours/month.",
  "icons": {
    "16": "public/logo-16-production.png",
    "48": "public/logo-48-production.png",
    "128": "public/logo-128-production.png"
