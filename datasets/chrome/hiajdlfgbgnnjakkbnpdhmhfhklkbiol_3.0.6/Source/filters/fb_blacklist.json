{
  "fb_privacy_rules": {
    "tracking_endpoints": [
      "*://www.facebook.com/tr/*",
      "*://connect.facebook.net/en_US/fbevents.js",
      "*://connect.facebook.net/signals/*",
      "*://www.facebook.com/impression.php*",
      "*://www.facebook.com/ajax/logging/*"
    ],
    "embed_plugin_logging": [
      "*://www.facebook.com/platform/logging/*",
      "*://www.facebook.com/plugins/error_logger*",
      "*://www.facebook.com/plugins/logging*"
    ],
    "exempted_domains": [
      "edge-chat.facebook.com",
      "messenger.com",
      "www.messenger.com",
      "www.facebook.com/chat/*",
      "www.facebook.com/ajax/presence/*"
    ]
  },
  "notes": "Blocks Facebook tracking/pixel and plugin telemetry while allowing Messenger/chat and Like plugins to function. Safer for users and Chrome Web Store review."
}