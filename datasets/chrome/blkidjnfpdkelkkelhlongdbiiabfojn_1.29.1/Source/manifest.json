{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "Нейромаркет - Реклама на Wildberries",
  "author": "Нейромаркет",
  "version": "1.29.1",
  "description": "Инструменты для Рекламы на Wildberries",
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "*://*.wildberries.ru/*",
      "*://*.wb.ru/*",
      "*://*.neuromarket.online/*",
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://127.0.0.1/*",
      "https://localhost/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "*://*.wildberries.ru/*",
    "*://*.wb.ru/*",
    "*://*.neuromarket.online/*"
  ],
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/inject.js"
      ]
    }
  ],
  "manifest_version": 3,
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "*.png",
        "onboarding.html"
      ],
      "matches": [
        "*://*.wildberries.ru/*",
        "*://*.wb.ru/*",
        "*://*.neuromarket.online/*"
      ]
    }
  ]
}