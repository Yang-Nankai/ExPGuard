{
"update_url": "https://clients2.google.com/service/update2/crx",

    "manifest_version": 3,
    "name": "__MSG_appName__",
    "description": "__MSG_appDesc__",
    "version": "3.3.2",
    "default_locale": "en",
    "key": "",
    "background": {
        "service_worker": "js/extension-worker.js",
        "type": "module"
    },
    "permissions": [
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "icons": {
        "128": "icons/icon-128.png",
        "48": "icons/icon-48.png",
        "16": "icons/icon-16.png"
    },
    "action": {
        "default_title": "__MSG_appName__"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "js/*",
                "css/*",
                "icons/*",
                "assets/*",
                "content.html",
                "sandbox-wasm.html"
            ],
            "matches": [
                "*://*/*"
            ]
        }
    ],
    "externally_connectable": {
        "matches": [
            "https://onlineapp.pro/*",
            "https://onlineapp.stream/*",
            "https://onlineapp.live/*"
        ]
    },
    "sandbox": {
        "pages": [
            "sandbox-wasm.html"
        ]
    },
    "commands": {
        "open-heic-to-jpg-converter": {
            "suggested_key": {
                "default": "Alt+J"
            },
            "description": "Open HEIC to JPG converter"
        }
    }
}
