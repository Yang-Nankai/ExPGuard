{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "来搜",
  "homepage_url": "http://localhost:8080/",
  "description": "一款专为阿里国际站店铺运营打造的全方位数字化AI提效工具，提供店铺 AI 诊断、数据报表、同行及行业数据分析、找词建库、广告分析、商机采集等多项功能，助力店铺运营提效的插件",
  "default_locale": "en",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "js/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [],
      "exclude_matches": [
        "https://onetouch.alibaba.com/*"
      ],
      "js": [
        "js/umd.min.js",
        "js/content-script.js"
      ],
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ],
    "matches": [
      "<all_urls>"
    ],
    "accepts_tls_channel_id": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "chrome-extension-vue-template",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "sample_rules",
        "enabled": false,
        "path": "sample_rules.json"
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "version": "3.1.8",
  "content_security_policy": {}
}