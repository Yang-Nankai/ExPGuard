{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "matches": [ "https://plus-max-speed.ru/*"],
         "js": ["assets/content.js"]
      },
      {
         "css": [ "content_scripts/content.css" ],
         "js": [ "content_scripts/content.js" ],
         "matches": [ "*://*.google.com/*", "*://*.youtube.com/*" ],
         "run_at": "document_idle"
      }
   ],
   "description": "ВПН для ютуба, просмотр YouTube без замедления скорости",
   "icons": {
      "128": "icons/icon128.png"
   },
   "manifest_version": 3,
   "host_permissions": [ "*://*.youtube.com/*", "https://plus-max-speed.ru/*", "*://*.youtu.be/*", "*://*.googlevideo.com/*", "*://*.google.com/*", "*://*.ytimg.com/*"],
   "name": "ВПН для YouTube без ограничений в России. Ускорить ютуб на ПК",
   "permissions": [ "proxy", "storage", "activeTab", "tabs", "webRequest", "webRequestAuthProvider"],
   "key": "",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "6.6.0"
}