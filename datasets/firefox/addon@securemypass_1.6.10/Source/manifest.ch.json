{
  "manifest_version": 3,
  "name": "Secure My Pass",
  "version": "1.6.10",
  "description": "Secure My Pass addon.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "cookies",
    "clipboardWrite",
    "sidePanel",
    "management",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "action": {
    "default_title": "Click to open",
    "default_icon": {
      "16": "icons/16x16.png",
      "48": "icons/32x32.png",
      "128": "icons/96x96.png"
    }
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": ["assets/webContentScript.js"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["assets/gsiClient.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "incognito": "split",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js"
  }
}
