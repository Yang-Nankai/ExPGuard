var loggingOn = false;
var whitelist = '';

function log(message)
{
   if(loggingOn) console.log(message);
}

window.addEventListener("message", function(event) {
  if (event.source != window)
    return;
  if (event.data.type && (event.data.type == "close_me")) {
      log("Received close command");
      chrome.runtime.sendMessage({command: "close_me"}, function(response) {});
  }
}, false);



var scriptToInsertInPage = function pcpitstop()
{

	function closeOverlay() {
		const scmoverlay = document.getElementById('pcmaticscamblockeroverlay');
		scmoverlay.remove();
		clickedlink.setAttribute('data-scamblocker-check','');
		clickedlink.click();

	}

	function backtoSafety() {
		const scmoverlay = document.getElementById('pcmaticscamblockeroverlay');
		scmoverlay.remove();
	}


	function addBadURLOverlay(title, text1, text2) {
		console.log('adding bad!!!!!!!')
		// create a new div element
		const body = document.body;
		const outerdiv = document.createElement('div');
		outerdiv.id='pcmaticscamblockeroverlay';
		outerdiv.style.position='fixed';
		outerdiv.style.top = '0';
		outerdiv.style.left = '0';
		outerdiv.style.width = '100%';
		outerdiv.style.height = '100%';
		outerdiv.style.backgroundColor = 'rgba(0,0,0,0.5)';
		outerdiv.style.zIndex = '9999';
		outerdiv.style.display = 'flex';
		outerdiv.style.justifyContent = 'center';
		outerdiv.style.alignItems = 'center';
		outerdiv.style.fontFamily = 'Arial, sans-serif';

		const innerdiv = document.createElement('div');
		innerdiv.style.backgroundColor = 'white';
		innerdiv.style.color = 'black';
		innerdiv.style.width = '500px';
		innerdiv.style.paddingTop = '50px';
		innerdiv.style.paddingBottom = '30px';
		innerdiv.style.paddingLeft = '50px';
		innerdiv.style.paddingRight = '50px';
		innerdiv.style.borderRadius = '14px';
		innerdiv.style.textAlign = 'center';
		innerdiv.style.fontFamily = 'Arial, sans-serif';

		const imageDiv = document.createElement('div');
		imageDiv.style.width = '100px';
		imageDiv.style.height = '100px';
		imageDiv.style.marginLeft = 'auto';
		imageDiv.style.marginRight = 'auto';
		imageDiv.style.marginTop = '-80px';


		var mySVG64 = "";
		imageDiv.style.backgroundImage = "url('data:image/svg+xml;base64," + mySVG64 + "')";

		const h1 = document.createElement('h1');
		h1.style.fontSize='28px';
		h1.style.fontWeight='800';
		h1.textContent = title;
		h1.style.fontFamily = 'Arial, sans-serif';
		h1.style.backgroundColor= 'white';
		

		const p = document.createElement('p');
		p.style.fontWeight='300';
		p.style.fontSize='13px';
		p.textContent = 'Attackers on the site you are attempting to visit might trick you into installing software or revealing things like your passwords, phone, or credit card numbers.';
		p.style.fontFamily = 'Arial, sans-serif';
		p.style.backgroundColor= 'white';

		const p2 = document.createElement('p');
		p2.style.fontWeight='600';
		p2.style.color='#b10a10';
		p2.style.fontSize='13px';
		p2.textContent = 'PCMatic strongly recommends going back to safety';
		p2.style.fontFamily = 'Arial, sans-serif';
		p2.style.backgroundColor= 'white';
		p2.style.display = 'block';

		const button1 = document.createElement('button');
		button1.style.cursor='pointer';
		button1.style.borderRadius = '14px';
		button1.style.backgroundColor='white';
		button1.style.width='330px';
		button1.style.color='black';
		button1.textContent = 'Continue Anyway';
		button1.addEventListener('click', closeOverlay);
		button1.style.fontFamily = 'Arial, sans-serif';
		button1.style.fontSize='13px';
		button1.style.padding = '14px';
		button1.style.border='1px solid #c0c0c0';
		button1.style.fontWeight='600';
		
		button1.addEventListener('mouseenter', () => {
			button1.style.backgroundColor = 'lightgray';
		});
		
		button1.addEventListener('mouseleave', () => {
			button1.style.backgroundColor = 'white'; 
		});

		const button2 = document.createElement('button');
		button2.style.padding = '14px';
		button2.style.cursor='pointer';
		button2.style.borderRadius = '14px';
		button2.style.marginTop = "50px";
		button2.style.width='330px';
		button2.style.backgroundColor='#40ce7c';
		button2.style.border='1px solid #40ce7c';
		button2.style.color='white';
		button2.textContent = 'Back to safety';
		button2.addEventListener('click', backtoSafety);
		button2.style.fontFamily = 'Arial, sans-serif';
		button2.style.fontSize='13px';
		button2.style.fontWeight='600';

		button2.addEventListener('mouseenter', () => {
			button2.style.backgroundColor = '#27814e';
		});
		
		button2.addEventListener('mouseleave', () => {
			button2.style.backgroundColor = '#40ce7c'; 
		});

		const emptyDiv = document.createElement('div');
		emptyDiv.style.height = '10px';

		innerdiv.appendChild(imageDiv)
		innerdiv.appendChild(h1)
		innerdiv.appendChild(p)
		innerdiv.appendChild(p2)
		//innerdiv.appendChild(emptyDiv)
		innerdiv.appendChild(button2)
		innerdiv.appendChild(emptyDiv)
		innerdiv.appendChild(button1)

		outerdiv.appendChild(innerdiv)

	body.before(outerdiv);
	}

		var clickedlink = '';

    //var serverAddress = "https://utilities.pcpitstop.com";
	var serverAddress = "http://staging.local";


		const links = document.querySelectorAll('a[href]');

		links.forEach(function(link) {

			link.setAttribute("data-scamblocker-check","check");

			link.addEventListener('click', function(event) {
				if (this.getAttribute('data-scamblocker-check') != 'check') return;
				event.preventDefault();
				event.stopImmediatePropagation();

				clickedlink=this;
				checkWithServerToBlockURL(clickedlink);
			},true);
		});

		let scamblockerelement_whitelist = document.getElementById('scamblocker-whitelist')
		scamblockerelement_whitelist.addEventListener("scamblocker-whitelist",
			function(event) {
				whitelist = scamblockerelement_whitelist.getAttribute('whitelist')
			}
		);

		let scamblockerelement_ismalicious = document.getElementById('scamblocker-ismalicious')
		scamblockerelement_ismalicious.addEventListener("scamblocker-ismalicious",
			function(evt) {
					let event = {
						detail: {
							url: scamblockerelement_ismalicious.getAttribute('url'),
							data: {
								block: scamblockerelement_ismalicious.getAttribute('data-block')=='true'? true:false,
								error: scamblockerelement_ismalicious.getAttribute('data-error'),
							},
							form: {
								req: scamblockerelement_ismalicious.getAttribute('form-req'),
								url: scamblockerelement_ismalicious.getAttribute('form-url'),
								atype: scamblockerelement_ismalicious.getAttribute('form-atype'),
								phone: scamblockerelement_ismalicious.getAttribute('form-phone'),
								message: scamblockerelement_ismalicious.getAttribute('form-message')
							}
						}
					};
					
					let checkedurl = scamblockerelement_ismalicious.getAttribute('data-checkurl')=='true'? true:false;
					let overlayTitle = scamblockerelement_ismalicious.getAttribute('data-title');
					let overlayText1 = scamblockerelement_ismalicious.getAttribute('data-text1');
					let overlayText2 = scamblockerelement_ismalicious.getAttribute('data-text2');


					if (checkedurl) {
						console.log('checked url blocked?')
						console.log(scamblockerelement_ismalicious.getAttribute('data-block')=='true')
						if(scamblockerelement_ismalicious.getAttribute('data-block')=='true') {
							//display bad
							console.log('BAD!!!')
							addBadURLOverlay(overlayTitle,overlayText1,overlayText2);
						} else {
							clickedlink.setAttribute('data-scamblocker-check','');
							clickedlink.click();
						}

					} else {
						handle_isMaliciousEvent(false,event);
					}

			}
		);


		document.dispatchEvent(new CustomEvent("contentEvent", {
			detail: {callingFunc: 'getStorage'}
		}));


    
    function blockingPost(url, form, callingFunc)
    {
			document.dispatchEvent(new CustomEvent("contentEvent", {
				detail: {type: 'serviceworker', callingFunc: callingFunc, url: url, form: form}
			}));
			
    }

		function checkWithServerToBlockURL(event)
    {
			//console.log('checkWithServerToBlockURL')
			//console.log(event)
			let href = event.getAttribute('href');

			let url = '';

			if(href.substring(0,4)!='http') {
				url =  window.location.origin + href;
			} else {
				url = href;
			}
			//console.log('checking url....')
			//console.log(url)

			blockingPost(serverAddress + "/plugin/check-risk2.asp",
					     {
						 		'url': url,
								'message': url
					     }
					    , 'isMalicious');
		
    }

	
};


var insertHandler = function(){
	if (window.trustedTypes && window.trustedTypes.createPolicy) {
		window.trustedTypes.createPolicy('default', {
		createHTML: string => string,
		createScriptURL: string => string,
		createScript: string => string,
		});
	}

    var disablerScriptElement = document.createElement('script');
		disablerScriptElement.type="text/javascript";
    disablerScriptElement.text= scriptToInsertInPage.toString()+";pcpitstop();";
    var insertLocation = document.head?document.head:(document.body?document.body:document.documentElement);
    insertLocation.appendChild(disablerScriptElement);
}

insertHandler();