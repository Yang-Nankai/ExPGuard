{
  "action": {
    "default_icon": {
      "128": "icon128.png",
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "description": "Bypass paywalls by accessing news orarchived versions of articles with one click",
  "manifest_version": 3,
  "name": "Remove Paywalls",
  "content_scripts": [
    {
      "matches": [
        "https://removepaywalls.com/*"
      ],
      "css": [
        "style.css"
      ]
    },
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "version": "1.2.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a7f2c94e-5b8d-4f9a-9c21-8e4b5d6f7a9c}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}