{
  "manifest_version": 3,
  "name": "Chat AI - SideBar AI by Fusion",
  "description": "Chat AI for Edge Search: for Google, Bing, Baidu and more. Generate Images with AI. Developed on GPT-4",
  "version": "1.5.0",
  "background": {
    "service_worker": "/background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-helper": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "Open Fusion Chat Assistant"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://fusionchat.ai/*",
      "https://*.fusionchat.ai/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "48": "/icons/48.png",
    "128": "/icons/128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "/content.js"
      ]
    }
  ],
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}