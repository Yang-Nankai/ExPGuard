{
  "version": "1.0.3",
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "/img/32.png",
      "32": "/img/32.png",
      "48": "/img/48.png",
      "64": "/img/64.png",
      "128": "/img/128.png"
    }
  },
  "icons": {
    "16": "/img/32.png",
    "32": "/img/32.png",
    "48": "/img/48.png",
    "64": "/img/64.png",
    "128": "/img/128.png"
  },
  "content_scripts": [
    {
      "css": [
        "/css/msg.css"
      ],
      "js": [
        "/js/jquery-2.1.1.min.js",
        "/js/function.js",
        "/js/content.js"
      ],
      "matches": [
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.tmall.hk/*",
        "https://*.jd.com/*",
        "https://*.jd.hk/*",
        "https://*.yangkeduo.com/*",
        "https://*.vipglobal.hk/*",
        "https://*.vip.com/*"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "background",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}