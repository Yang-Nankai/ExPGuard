{
  "manifest_version": 3,
  "name": "Search eBay - Find Stuff Fast",
  "short_name": "Search eBay",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "description": "Highlight text, right-click, and search eBay instantly. Supports 30+ international sites with powerful filters. No tracking, no ads.",
  "action": {
    "default_icon": {
      "16": "images/new-logo-16.png",
      "24": "images/new-logo-24.png",
      "32": "images/new-logo-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Search eBay"
  },
  "options_page": "options.html",
  "icons": {
    "16": "images/new-logo-16.png",
    "48": "images/new-logo-48.png",
    "128": "images/new-logo-128.png"
  },
  "permissions": [
    "tabs",
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "omnibox": {
    "keyword": "ebay"
  },
  "commands": {
    "search-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Search selected text on eBay"
    }
  },
  "version": "5.0.0",
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}