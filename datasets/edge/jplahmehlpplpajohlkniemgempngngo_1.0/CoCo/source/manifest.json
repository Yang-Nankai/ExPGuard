{
  "manifest_version": 3,
  "name": "Image Downloader Manager [IDM] Double Click Downloader",
  "version": "1.0",
  "description": "Download any image by double-clicking on it.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png"
  },
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}