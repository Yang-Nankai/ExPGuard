{
  "manifest_version": 3,
  "name": "WASheet: Bulk Message Sender & WhatsApp CRM",
  "version": "1.2.47",
  "description": "Send bulk messages via Excel, automate messaging, manage contacts, and boost productivity with AI for smooth WhatsApp communication.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "resources": [
        "ReactLib.js",
        "/assets/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}