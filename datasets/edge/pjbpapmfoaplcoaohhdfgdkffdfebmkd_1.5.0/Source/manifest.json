{
  "name": "Bark for Microsoft Edge",
  "short_name": "Bark",
  "description": "Monitor Microsoft Edge web browsing for inappropriate content.",
  "version": "1.5.0",
  "permissions": [
    "tabs",
    "identity",
    "identity.email",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.canva.com/*",
    "https://urls.bark.us/*"
  ],
  "optional_permissions": [
    "management"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://*.canva.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "monitor.js"
  },
  "icons": {
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "manifest_version": 3,
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}