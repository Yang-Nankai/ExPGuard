{
  "manifest_version": 3,
  "name": "SyncFun",
  "version": "1.0.2",
  "description": "Watch streaming media with friends.",
  "permissions": [
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "scripting",
    "cookies",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "contentSettings"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://bobobili.cn/*",
      "https://bobobili.cn/*"
    ]
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "SyncFun",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "js": [
        "assets/app.js-loader-D8i6_R5u.js"
      ],
      "matches": [
        "http://localhost:3000/*",
        "http://bobobili.cn/*",
        "https://bobobili.cn/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/first.js-CSQSuO-B.js"
      ],
      "matches": [
        "*://*/*"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "src/background/get-media-time.js",
        "src/background/pause-media.js",
        "src/background/webview.js",
        "src/background/player.js",
        "src/background/player-main-world.js",
        "src/content/first-main-world.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "http://bobobili.cn/*",
        "http://localhost:3000/*",
        "https://bobobili.cn/*"
      ],
      "resources": [
        "assets/browser-polyfill-DgstG05v.js",
        "assets/app.js-kZh2Hswh.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "assets/first.js-CSQSuO-B.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}