{
  "manifest_version": 3,
  "name": "多多对账-拼多多订单、账单分析工具",
  "version": "1.0.4",
  "description": "一款方便拼多多商家核对订单和账单的插件",
  "icons": {
    "16": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  },
  "action": {
    "default_icon": "img/icon.png",
    "default_title": "多多对账-拼多多订单、账单分析工具",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinduoduo.com/*"
      ],
      "js": [
        "js/jquery.min.js",
        "js/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.dalualex.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.dalualex.com/*"
    ]
  },
  "permissions": [
    "downloads",
    "tabs",
    "storage",
    "unlimitedStorage",
    "system.display"
  ],
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}