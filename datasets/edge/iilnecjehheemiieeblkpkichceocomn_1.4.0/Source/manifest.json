{
  "manifest_version": 3,
  "name": "鲸麦GemX.ai",
  "description": "鲸麦GemX.ai基于大数据和人工智能技术，对亚马逊市场变化和卖家运营数据进行持续的深度分析，帮助卖家一站式大数据选品、产品开发和精细化运营。",
  "version": "1.4.0",
  "action": {
    "default_title": "鲸麦GemX.ai",
    "default_icon": "assets/images/logo-round-0223.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "webRequest"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "*://www.amazon.co.jp/*",
    "*://www.amazon.fr/*",
    "*://www.amazon.de/*",
    "*://www.amazon.co.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/images/logo-round-0223.png",
    "48": "assets/images/logo-round-0223.png",
    "128": "assets/images/logo-round-0223.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "css": [
        "css/chunk-vendors.css",
        "css/content.css"
      ],
      "js": [
        "js/chunk-vendors.js",
        "js/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/inject.js",
        "assets/images/*",
        "manifest.json"
      ],
      "matches": [
        "https://*.amazon.com/*",
        "https://*.merlinks.com/*",
        "https://*.genmatrix.cn/*",
        "https://*.gemx.ai/*",
        "http://localhost:8001/*",
        "http://*.merlinks.com/*",
        "*://www.amazon.co.jp/*",
        "*://www.amazon.fr/*",
        "*://www.amazon.de/*",
        "*://www.amazon.co.uk/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.merlinks.com/*",
      "https://*.genmatrix.cn/*",
      "https://*.gemx.ai/*",
      "http://localhost:8001/*",
      "http://*.merlinks.com/*"
    ]
  },
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}