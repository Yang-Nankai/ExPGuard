{
  "manifest_version": 3,
  "name": "__MSG_EDGE_extensionTitle__",
  "version": "2.0.17",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://* http://*;"
  },
  "action": {
    "default_title": "点击打开AskGo侧边栏"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "options/*"
      ],
      "use_dynamic_url": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.askgo.io/*",
      "http://localhost:8050/*",
      "https://*.askgo.co/*"
    ]
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "src/assets/favicon.ico",
    "19": "src/assets/favicon.ico",
    "38": "src/assets/favicon.ico",
    "48": "src/assets/favicon.ico",
    "128": "src/assets/favicon.ico"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "identity",
    "activeTab",
    "storage"
  ],
  "oauth2": {
    "client_id": "923046637900-ohuk96jkkbr7eu4ljbmc2ogtcb7952l5.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}