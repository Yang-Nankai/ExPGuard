<div id="gwdang-b2c-dp-detail" class="panel gwd_compare top-compare-detail top-bar-detail">
  <div class="panel-wrap">
    <div class="b2c-pages blkcolor4">
      第&nbsp;
      <span class="current-page" id="b2c-current-page">1</span>
      &nbsp;页，共
      <span class="page-num blkcolor4" id="b2c-page-num">{{pages}}</span>
      &nbsp;页
    </div>
    <ul class="buy-list">
      <li><b class="blkcolor1">正品商城在卖：</b></li>
      {{each data.store2}}
      <li>
        <img class="store" src="{{$value.icon_url}}">
        <a href="{{$value.url}}" title="{{$value.site_name}}" target="_blank">
          <span class="gwd_title blkcolor2">{{$value.site_name}}</span>
          {{if $value.more>1}}
          <span class="more">({{$value.more}})款</span>
          {{/if}}
          <span class="price prifontf">¥{{$value.price2}}</span>
        </a>
      </li>
      {{/each}}
      <li class="see-all-list">
      <a href="http://www.gwdang.com/dp{{now_dp_id}}/where_buy/?from=browser&crc64=1&m=b2c#tabs"target="_blank">
        <span class="show-all blkcolor4">查看全部商家({{storeLen}})</span>
      </a>
      </li>
    </ul>
    <div class="left-page turn-page">
      <a id="b2c-prev-page" target="_self" title="上一页" href="javascript:" class="gwd_bg"></a>
    </div>
    <div class="all-products" style="width:{{productW}}px">
      <ul id="b2c-item-list">
        {{each data.product}}
          <li id="b2c-prod-item-{{$index}}" >
            <a id="img-{{$value.dp_id}}" title="{{$value.title}}" target="_blank" class="small-img" href="{{$value.url}}">
              <img src="{{imgLoad}}" data-original="{{$value.img_url}}" id="dp-image-small-{{$value.dp_id}}" class="gwdang-lazy">
            </a>
            <a target="_blank" class="b2c-other-info"  href="{{$value.url}}">
              <div class="priceinfo-box">
                <div class="center-box">
                  <span class="gwd-price prifontf">¥{{$value.price_rmb ? $value.price_rmb : $value.price}}</span>
                  {{if $value.promo2}}
                  <span class="dp-promotion gwd_bg">
                    <div class="dp-promotion-detail">
                      {{each $value.promo2}}
                        <span class="dp-pro-item">{{$value}}</span>
                      {{/each}}
                    </div>
                  </span>
                  {{/if}}
                  {{if $value.coupon2}}
                  <span class="dp-coupon gwd_bg">
                    <div class="dp-coupon-detail">
                      {{each $value.coupon2}}
                        <span class="dp-coupon-item">{{$value}}</span>
                      {{/each}}
                    </div>
                  </span>
                  {{/if}}
                  {{if $value.yushou2}}
                  <span class="dp-yushou gwd_bg">
                    <div class="dp-yushou-detail">
                      {{each $value.yushou2}}
                        <span class="dp-pro-item">{{$value}}</span>
                      {{/each}}
                    </div>
                  </span>
                  {{/if}}
                </div>
              </div>
              
              <span class="b2c-store blkcolor1">{{$value.site_name}}</span>
              {{if $value.promodom}}
              <span id="{{$value.dp_id}}_promotion">{{$value.promodom}}</span>
              {{/if}}
              <span class="b2c-fees blkcolor4">{{$value.comment_num ? ("评论数:" + $value.comment_num) : $value.fee }}</span>
              <span class="b2c-tle blkcolor1">{{$value.title}}</span>
            </a>
          </li>
        {{/each}}
      </ul>
    </div>
    <div class="right-page turn-page">
      <a id="b2c-next-page" title="下一页" target="_self" href="javascript:" class="gwd_bg"></a>
    </div>
  </div>
  <style type="text/css">
    #gwdang-b2c-dp-detail .turn-page {
      width: {{width}}px;
    }
  </style>
</div>


