{
	"manifest_version": 2,
	"name": "A+ FontSize Changer Pro", 
	"short_name" : "A+ FontSize", 
	"author": "Jeff Baker",
	"version": "1.0",
	"description": "Extension that lets the user customize the font text size, font color and background color on a page.", 
	"icons": {
		"16": "images/fsicon16.png", /* Optional: Used as favicon for extensions page */
		"48": "images/fsicon48.png", /* Used on chrome://extensions page */
		"128": "images/fsicon128.png" /* Used by Chrome Web Store */
	},
	"permissions": [ 
		"http://www.seabreezecomputers.com/", // Permission to use ajax here
		"https://www.seabreezecomputers.com/", // Permission to use ajax here
		"http://192.168.1.5/", // testing ajax here
		"tabs", // So popup.js can get the url of the current tab
		"storage", // To use chrome.storage.sync or chrome.storage.local
		"unlimitedStorage" // Removes 5MB limit to chrome.storage.local
		], 
	
	"browser_action": {
		"default_icon": "images/fsicon38.png", /* Icon in toolbar (19px or 38px) */
		"default_title": "A+ FontSize Changer Pro",      /* optional; shown as a tooltip when mouse hovers over icon */
		"default_popup": "popup.html"
	},
	"background": {
  		"scripts": ["background.js"] /* Script that is always running in background */
	},
	"content_scripts": [
    {
		"matches": ["<all_urls>"], /* script will be loaded on all urls */
		"js": ["fontsize.js", "storage.js"], /* comma separated list of js files */
		"css": [],
		"all_frames": true, /* to be able to access cross-origin iframes */
		"run_at": "document_end" 
	} ]

}
