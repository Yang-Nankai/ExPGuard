{
  "manifest_version": 3,
  "name": "DeepSeek+Gemini3侧边栏-小七AI",
  "version": "2.0.1",
  "description": "侧边栏！免费免登录！不需要API-key！AI智能搜索结果🔍，DeepSeek+Gemini3双模型驱动，AI识图📖、文档理解、写作与图片生成🖋️、免费翻译",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "options_ui": {
    "open_in_tab": true,
    "page": "setting.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html",
    "default_state": "open"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://api.87dh.com/*",
    "https://*.xiaoqi-ai.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "*://*.xiaoqi-ai.com/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "小七AI助手 - 由DeepSeek+Gemini3双模型驱动",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
