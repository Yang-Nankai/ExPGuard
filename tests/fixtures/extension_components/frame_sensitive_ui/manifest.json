{
  "manifest_version": 3,
  "name": "Frame-sensitive source fixture",
  "version": "1.0",
  "permissions": ["bookmarks"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }]
}
