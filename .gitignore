cdp_fixture/
dynamic-batch/
Temp/
smoke/
.tmp-main-current/
*.aux
*.fdb_latexmk
*.fls
*.out
*.png
flow-verification-*.json

# Older lowercase source trees are excluded. The curated dataset uses a
# capitalized Source/ directory and versions that source with its scan results.
datasets/chrome/*/source/
datasets/edge/*/source/
datasets/firefox/*/source/
datasets/updates/*/
!datasets/updates/lookups/
!datasets/updates/lookups/**
!datasets/updates/revalidation/
!datasets/updates/revalidation/**

# Version the unpacked source trees and retained ExPGuard diagnostic logs.
!datasets/chrome/*/Source/
!datasets/chrome/*/Source/**
!datasets/edge/*/Source/
!datasets/edge/*/Source/**
!datasets/firefox/*/Source/
!datasets/firefox/*/Source/**
!datasets/chrome/*/ExPGuard/analysis.log
!datasets/edge/*/ExPGuard/analysis.log
!datasets/firefox/*/ExPGuard/analysis.log
