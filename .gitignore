batch/
data/
knowledge/
patches/
ExPGuard-*-Test/
*.crx
*.xpi
*.zip
!samples/**

# Local helper and one-off process files
/CREATE_SAMPLES.sh
/create_sample_*.sh
/test_advanced_samples.sh
tmp/
temp/
.tmp*/
*.tmp
*.bak
*.bkp

