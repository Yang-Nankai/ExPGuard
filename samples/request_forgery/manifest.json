{
  "manifest_version": 3,
  "name": "Partner SSO Connector",
  "version": "0.9.7",
  "description": "Accepts external messages from approved partner extensions and proxies HTTP requests on their behalf.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.partner-a.example/*",
    "https://api.partner-b.example/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["https://*.partner-a.example/*"]
  }
}
