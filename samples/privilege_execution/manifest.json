{
  "manifest_version": 3,
  "name": "Bookmark Flow Demo",
  "version": "1.0",
  "permissions": ["storage", "bookmarks"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}