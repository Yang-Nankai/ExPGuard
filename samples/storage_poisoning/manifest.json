{
  "manifest_version": 3,
  "name": "Custom Theme Cloud Sync",
  "version": "2.1.4",
  "description": "Syncs the user's preferred theme + auto-redirect rules between devices via chrome.storage.sync.",
  "permissions": ["storage", "history", "tabs"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*.theme-marketplace.example/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
