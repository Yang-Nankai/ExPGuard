{
  "manifest_version": 3,
  "name": "Devtools Co-pilot",
  "version": "1.4.0",
  "description": "Co-ordinates devtools-like helpers across multiple frames via runtime ports and pageCapture.",
  "permissions": ["scripting", "tabs", "storage", "pageCapture", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.devhub.example/*"],
      "js": ["content.js"]
    }
  ],
  "externally_connectable": {
    "ids": ["*"]
  }
}
