{
  "manifest_version": 3,
  "name": "Quick Translate Sidebar",
  "version": "3.0.1",
  "description": "Translates selected text on the page using rules supplied by an in-page widget.",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
