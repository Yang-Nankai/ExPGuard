{
  "manifest_version": 3,
  "name": "Smart Form Assistant",
  "version": "1.5.0",
  "description": "Intelligent form filling and click tracking assistant",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
